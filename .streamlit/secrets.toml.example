# Copy these names into Streamlit Community Cloud's Advanced settings.
# Never commit the real values or a secrets.toml file.
APP_PASSWORD = "replace-with-a-long-random-password"
ONEMAP_EMAIL = "your-onemap-email"
ONEMAP_PASSWORD = "your-onemap-password"
# Optional: powers the hourly page's standby-driver advisor. Leave unset to
# have that feature degrade to "not configured" without breaking the page.
GEM_KEY = "your-gemini-api-key"
